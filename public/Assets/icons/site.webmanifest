{
  "id": "metromark",
  "name": "MetroMark",
  "short_name": "MetroMark",
  "description": "Transit Exploration Tracker",
  "start_url": ".",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#333333",
  "theme_color": "#333333",
  "icons": [
    {
      "src": "/Assets/icons/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/Assets/icons/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/Assets/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/Assets/icons/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/Assets/icons/screenshot-desktop.jpeg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "MetroMark — explore transit routes"
    },
    {
      "src": "/Assets/icons/screenshot-mobile.jpeg",
      "sizes": "412x915",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "MetroMark — track visited stations"
    }
  ]
}
