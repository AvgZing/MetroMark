# Development profile (safe local testing)
APP_ENV=development
PORT=8080
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_dev_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_dev_supabase_service_role_key

# Local PostgreSQL/PostGIS cache storage for transit data.
# Keep this in a machine-local .env file that is not committed.
METROMARK_LOCAL_PGHOST=127.0.0.1
METROMARK_LOCAL_PGPORT=5432
METROMARK_LOCAL_PGUSER=postgres
METROMARK_LOCAL_PGPASSWORD=replace_with_local_postgres_password
METROMARK_LOCAL_PGDATABASE=metromark_cache
METROMARK_LOCAL_PGSSL=disable

TRANSITLAND_API_KEY=replace_with_transitland_api_key
TRANSIT_CACHE_TTL_HOURS=876000
TRANSIT_CACHE_STALE_DAYS=36500
LINE_VIEW_ORDERING_VOTE_THRESHOLD=5
TRANSITLAND_REQUEST_TIMEOUT_MS=120000

# Daily Transitland API quota limits (enforced across all harvesters + on-demand backfill).
HARVEST_DAILY_REST_LIMIT=250
HARVEST_DAILY_VECTOR_LIMIT=2500
HARVEST_DAILY_ROUTING_LIMIT=250

ADMIN_EMAIL=admin@metromark.app
ADMIN_PASSWORD=replace_with_admin_password
BACKUP_OUTPUT_DIR=data/backups/dev
# Service worker (PWA): 1 to register /sw.js, 0 to disable. Requires HTTPS or localhost.
SW_ENABLED=0

# Optional: explicit env file path (default: .env.development / .env.production by APP_ENV)
# METROMARK_ENV_FILE=.env.development

# Ops tooling (optional, read directly by operations/ scripts):
# TIPPECANOE_BIN=C:\msys64\usr\bin\tippecanoe.exe
# WORLD_HARVEST_START_ZOOM=4
# WORLD_HARVEST_MAX_ZOOM=9
# WORLD_CITY_SPAN_DEGREES=0.7
